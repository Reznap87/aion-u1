{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion.local/schemas/training-example.schema.json",
  "title": "AION-U1 verified training example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "messages",
    "capabilities",
    "provenance",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 16
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant", "tool"]
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": ["teacher_alias", "teacher_model_id"],
      "properties": {
        "teacher_alias": {
          "type": "string"
        },
        "teacher_model_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["status", "score", "method"],
      "properties": {
        "status": {
          "type": "string",
          "const": "verified"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
